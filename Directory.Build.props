<Project>
  <!-- ============================================================
       NGUON SU THAT DUY NHAT cho metadata cua toan bo giai phap.
       Doi version O DAY -> exe, installer va winget manifest deu
       lay theo. Khong khai bao Version trong tung .csproj nua.

       Dang so hieu: YY.M.DDNN (docs/DESIGN_SYSTEM.md muc 6)
         26.8.1901 = ban thu 01 ngay 19/08/2026
         26.8.1902 = ban thu 02 CUNG ngay
         26.8.2001 = ban thu 01 ngay 20/08/2026
       DD va NN deu PHAI du hai chu so - xem docs/VERSIONING.md.
       ============================================================ -->
  <PropertyGroup>
    <VersionPrefix>26.8.1901</VersionPrefix>
    <Company>tsudev</Company>
    <Authors>tsudev</Authors>
    <Product>tsudev SWICO</Product>
    <Copyright>Copyright (c) 2026 tsudev</Copyright>
    <Description>Kiểm tra bản quyền Windows và thu thập cấu hình phần cứng</Description>
    <RepositoryUrl>https://github.com/tsudev-tsudev/swico</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Canh bao = loi. Bat duoc sau khi da don sach 27 canh bao ton dong;
         de mo lai thi chung tich tu tro lai va khong ai doc nua.
         Cac quy tac duoc tat co ly do cu the nam trong .editorconfig. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
