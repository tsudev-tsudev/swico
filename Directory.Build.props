<Project>
  <!-- ============================================================
       NGUON SU THAT DUY NHAT cho metadata cua toan bo giai phap.
       Doi version O DAY -> exe, installer va winget manifest deu
       lay theo. Khong khai bao Version trong tung .csproj nua.
       ============================================================ -->
  <PropertyGroup>
    <VersionPrefix>26.8.18.2</VersionPrefix>
    <Company>tsudev</Company>
    <Authors>tsudev</Authors>
    <Product>tsudev SWICO</Product>
    <Copyright>Copyright (c) 2026 tsudev</Copyright>
    <Description>Kiểm tra bản quyền Windows và thu thập cấu hình phần cứng</Description>
    <RepositoryUrl>https://github.com/tsudev-tsudev/swico</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Canh bao = loi. Bat duoc sau khi da don sach 27 canh bao ton dong;
         de mo lai thi chung tich tu tro lai va khong ai doc nua.
         Cac quy tac duoc tat co ly do cu the nam trong .editorconfig. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
